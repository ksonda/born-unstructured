---
import { getCollection, render } from 'astro:content';
import EpisodeGraph from '../../components/graph/EpisodeGraph.svelte';
import GraphProse from '../../components/GraphProse.astro';
import PositionTable from '../../components/PositionTable.astro';
import Stamp from '../../components/Stamp.astro';
import Thing from '../../components/Thing.astro';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/format.ts';
import { slugFromFile } from '../../lib/graph/compile.ts';
import { nodeFor } from '../../lib/graph/jsonld.ts';
import { episodeView } from '../../lib/graph/neighborhood.ts';
import { explorerPath, pathFor } from '../../lib/graph/routes.ts';
import { hasGraphMarker } from '../../lib/prose.ts';
import { stance } from '../../lib/graph/stances.ts';
import { claimHistory, claimStatus, contributionOf, cutoff, entityLabel, postFor } from '../../lib/graph/views.ts';
import { withBase } from '../../lib/paths.ts';
import { getSiteGraph } from '../../lib/site-graph.ts';

export async function getStaticPaths() {
  const graph = await getSiteGraph();
  const entries = await getCollection('posts');
  return graph.posts.map((post) => ({
    params: { slug: post.slug },
    props: { postId: post.id, entry: entries.find((e) => slugFromFile(e.id) === post.slug)! },
  }));
}

const { postId, entry } = Astro.props;
const graph = await getSiteGraph();
const post = postFor(graph, postId)!;
const { Content } = await render(entry);

// The local picture shows the record as it stood when this episode came out.
const asOf = cutoff(graph, post.episode);
const view = episodeView(asOf, post.id);
const labelOf = (id: string) =>
  graph.entities.find((e) => e.id === id)?.label ?? graph.claims.find((c) => c.id === id)?.label ?? id;
const links = Object.fromEntries(
  view.nodes
    .map((n) => n.id)
    .concat(view.edges.flatMap((e) => (e.record ? [e.record] : [])))
    .map((id) => [
      id,
      {
        label: labelOf(id),
        page: withBase(pathFor(graph, id)!),
        explore: withBase(explorerPath(graph, id, post.episode) ?? '/explore/'),
      },
    ]),
);

const added = contributionOf(graph, post.id);
const touched = [...new Set([...added.claims.map((c) => c.id), ...added.assessments.map((a) => a.claim)])].map(
  (id) => graph.claims.find((c) => c.id === id)!,
);
const threads = touched
  .map((claim) => ({
    claim,
    earlier: claim.episode < post.episode ? postFor(graph, claim.post)! : null,
    later: claimHistory(graph, claim.id).filter((a) => a.episode > post.episode),
  }))
  .filter((t) => t.earlier || t.later.length);

// An episode can place its picture inside the prose with a ::graph:: line.
const graphInProse = view.nodes.length > 0 && hasGraphMarker(entry.body ?? '');

const previous = graph.posts.find((p) => p.episode === post.episode - 1);
const next = graph.posts.find((p) => p.episode === post.episode + 1);
---

<Base title={post.title} description={post.summary} jsonld={nodeFor(graph, post.id)}>
  <article>
    <header class="episode-head">
      <p class="quiet">Episode {post.episode}, {formatDate(post.published)}</p>
      <h1>{post.title}</h1>
    </header>

    {
      post.sample && (
        <p class="notice measure">
          <strong>Sample episode.</strong> This installment is made up. It is here to show how claims, evidence and
          changes of mind accumulate across the series, and it will be replaced by the real thing.
        </p>
      )
    }

    <GraphProse>
      <Content />
      <Fragment slot="graph">
        <EpisodeGraph client:visible view={view} links={links} />
      </Fragment>
    </GraphProse>

    <section id="record" class="record">
      <h2>This episode's contribution to human knowledge</h2>

      {
        added.observations.length > 0 && (
          <>
            <h3>Observations</h3>
            <ul class="observation-list">
              {added.observations.map((o) => (
                <li>
                  <p>{o.text}</p>
                  <p class="quiet small">
                    Observed by {entityLabel(graph, o.observedBy)}.{' '}
                    {o.hasPassage && <a href={`#${o.id}`}>Show the passage</a>}
                  </p>
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        added.claims.length > 0 && (
          <>
            <h3>New claims</h3>
            <ul class="plain-list new-claims">
              {added.claims.map((c) => (
                <li>
                  <a href={withBase(`/claims/${c.id}/`)}>{c.label}</a>
                  <span class="quiet">, proposed by {entityLabel(graph, c.attributedTo)}</span>
                  <br />
                  <span class="small quiet">Status today:</span> <Stamp status={claimStatus(graph, c.id)} />
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        added.assessments.length > 0 && (
          <>
            <h3>Positions taken</h3>
            <PositionTable graph={graph} assessments={added.assessments} showClaim />
          </>
        )
      }
    </section>

    {
      view.nodes.length > 0 && (
        <section>
          <h2>{graphInProse ? 'In this episode' : 'How it connects'}</h2>
          {!graphInProse && (
            <>
              <p class="measure quiet">
                The things in this episode and the claims it touched, as the record stood on {formatDate(post.published)}.
                Solid lines are household facts. Dashed lines are somebody's theory.
              </p>
              <EpisodeGraph client:visible view={view} links={links} />
            </>
          )}
          <ul class="chips">
            {post.mentions.map((id) => (
              <li>
                <Thing graph={graph} id={id} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      threads.length > 0 && (
        <section>
          <h2>Before and after</h2>
          <ul class="thread-list">
            {threads.map(({ claim, earlier, later }) => (
              <li>
                <a href={withBase(`/claims/${claim.id}/`)}>{claim.label}</a>
                <ul>
                  {earlier && (
                    <li>
                      First proposed in{' '}
                      <a href={withBase(`/episodes/${earlier.slug}/`)}>
                        episode {earlier.episode}, {earlier.title}
                      </a>
                    </li>
                  )}
                  {later.map((a) => (
                    <li>
                      Later, in <a href={withBase(pathFor(graph, a.id)!)}>episode {a.episode}</a>: {entityLabel(graph, a.by)}{' '}
                      <span class="stance" data-polarity={stance(a.stance).polarity}>
                        {stance(a.stance).verb}
                      </span>{' '}
                      it
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="pager" aria-label="Episodes">
      {
        previous ? (
          <a href={withBase(`/episodes/${previous.slug}/`)}>
            <span class="quiet small">Previous episode</span>
            <br />
            {previous.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="pager__next" href={withBase(`/episodes/${next.slug}/`)}>
            <span class="quiet small">Next episode</span>
            <br />
            {next.title}
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .episode-head {
    margin-bottom: 2rem;
  }
  .episode-head p {
    margin-bottom: 0.4rem;
  }
  .episode-head h1 {
    max-width: 18ch;
  }
  .record {
    margin-top: 3.5rem;
    padding-top: 0.5rem;
    border-top: 3px double var(--rule);
  }
  .observation-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--measure);
  }
  .observation-list li {
    padding: 0.7rem 0 0.7rem 1rem;
    border-left: 3px solid var(--blue-wash);
    margin-bottom: 0.5rem;
  }
  .observation-list p {
    margin: 0;
  }
  .new-claims li {
    margin-bottom: 0.9rem;
  }
  .thread-list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }
  .thread-list > li {
    padding: 0.8rem 0;
    border-top: 1px solid var(--rule);
    font-weight: 600;
  }
  .thread-list ul {
    font-weight: 400;
    margin: 0.3rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.97rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }
  .pager a {
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.1rem;
    line-height: 1.25;
  }
  .pager__next {
    text-align: right;
  }
</style>
