---
import Base from '../../layouts/Base.astro';
import { shortDate } from '../../lib/format.ts';
import { contributionOf } from '../../lib/graph/views.ts';
import { withBase } from '../../lib/paths.ts';
import { getSiteGraph } from '../../lib/site-graph.ts';

const graph = await getSiteGraph();
const posts = [...graph.posts].reverse();
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---

<Base title="Posts" description="Every post, newest first.">
  <h1>Posts</h1>
  <p class="lede">Newest first. Each one adds a few observations, claims and changes of mind to the same graph.</p>
  <ol class="entry-list" reversed style="margin-top:2rem">
    {
      posts.map((post) => {
        const added = contributionOf(graph, post.id);
        return (
          <li>
            <span class="entry-no">{shortDate(post.published)}</span>
            <div>
              <h3>
                <a href={withBase(`/posts/${post.slug}/`)}>{post.title}</a>
              </h3>
              <p>{post.summary}</p>
              <p class="quiet small">
                Added {plural(added.observations.length, 'observation')},{' '}
                {plural(added.claims.length, 'new claim')} and {plural(added.assessments.length, 'position')}.
              </p>
            </div>
          </li>
        );
      })
    }
  </ol>
</Base>
