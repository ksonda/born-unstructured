---
import GraphExplorer from '../../components/graph/GraphExplorer.svelte';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths.ts';
import { SITE } from '../../site.config.ts';
---

<Base title="Explore" description="Browse the people, objects and theories in the series and how they connect." wide>
  <header class="explore-head">
    <h1>Explore</h1>
    <p class="quiet">
      Pick a thing and see what surrounds it. Select anything to read what is on file; use <strong>Focus here</strong> to re-center on it. Or{' '}
      <a href={withBase('/ask/')}>ask the household a question</a>.
    </p>
  </header>
  <GraphExplorer client:only="svelte" dataUrl={withBase('/data/site-graph.json')} base={withBase('')} defaultFocus={SITE.defaultFocus} />
  <noscript>
    <p class="panel">
      The explorer needs JavaScript. Everything in it is also available as ordinary pages: start from <a href={withBase('/things/')}>all things</a> or{' '}
      <a href={withBase('/beliefs/')}>things we believed</a>.
    </p>
  </noscript>
</Base>

<style>
  .explore-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .explore-head h1 {
    font-size: clamp(1.7rem, 4vw, 2.2rem);
  }
  .explore-head p {
    margin: 0;
    max-width: 70ch;
    font-size: 0.97rem;
  }
</style>
